{
  "version": 1,
  "hooks": {
    "afterShellExecution": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/auto-push-after-commit.ps1",
        "matcher": "git\\s+commit",
        "timeout": 120
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/auto-push-on-stop.ps1",
        "timeout": 120
      }
    ]
  }
}
